theme = Catppuccin Mocha
font-family = "JetBrainsMono Nerd Font Mono"
font-size = 13
font-thicken = true
window-padding-x = 10
window-padding-y = 5
# Pi/tmux-friendly modified Enter keys (Kitty CSI-u encoding): shift+enter = newline, cmd+enter = submit.
# cmd+enter replaces Ghostty's default toggle_fullscreen; use cmd+ctrl+f for fullscreen instead.
keybind = shift+enter=text:\x1b[13;2u
keybind = cmd+enter=text:\x1b[13;9u
