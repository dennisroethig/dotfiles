# Path to your Oh My Zsh installation.
export ZSH="$HOME/.oh-my-zsh"

# Theme (disabled — using Starship prompt)
ZSH_THEME=""

# Plugins
plugins=(git zsh-syntax-highlighting)

source $ZSH/oh-my-zsh.sh

# Aliases
alias unlock="security unlock-keychain ~/Library/Keychains/login.keychain-db"
alias tc="tmux new -As claude"
alias tailscale="/Applications/Tailscale.app/Contents/MacOS/Tailscale"
alias claude="claude --dangerously-skip-permissions"

# Dev tools
source ~/.devrc

# Secrets (API keys, tokens — not checked into git)
[ -f ~/.secrets ] && source ~/.secrets

# bun completions
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"
# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# LM Studio CLI (lms)
export PATH="$PATH:$HOME/.lmstudio/bin"

export PATH="$HOME/.local/bin:$PATH"

# Carapace completions
source <(carapace _carapace)

# Clean up terminal modes a crashed/disconnected TUI (e.g. Claude Code over ssh)
# may have left behind, before each prompt:
#   - mouse reporting (?1000-?1015)      -> symptom: "35;66;38M" junk on mouse move
#   - kitty keyboard protocol (CSI =0;1u) -> symptom: "c9;1:3u" junk after each key
# Claude Code >= 2.1.27x pushes the kitty protocol on the client terminal even
# over ssh; if the connection drops it never sends the pop (CSI <u).
autoload -Uz add-zsh-hook
# Skip inside tmux: tmux manages client-side mouse/keyboard modes itself and
# these sequences would pass through and break wheel scroll / extended keys.
_reset_tui_modes() {
  [[ -z $TMUX ]] && printf '\e[?1000l\e[?1002l\e[?1003l\e[?1005l\e[?1006l\e[?1015l\e[=0;1u'
}
add-zsh-hook precmd _reset_tui_modes

# Starship prompt
eval "$(starship init zsh)"

# Zoxide (must be last)
eval "$(zoxide init zsh)"
